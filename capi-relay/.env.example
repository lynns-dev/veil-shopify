# Meta (Events Manager -> your pixel -> Settings -> Conversions API -> Generate access token)
META_ACCESS_TOKEN=
META_PIXEL_ID=

# Optional: set while testing so events land in Events Manager's "Test Events" tab
# instead of live reporting. Remove once verified.
META_TEST_EVENT_CODE=

# Shopify custom app's Client Secret, used to verify the X-Shopify-Hmac-Sha256 header
# on incoming webhooks. Same value regardless of API version/scopes.
SHOPIFY_WEBHOOK_SECRET=
