{% doc %}
  @prompt
    Add a centered three-step section titled "Pressed once. Never again." in uppercase letter-spaced type. Three columns, each with a small uppercase number-label and a short sentence-case line: "01 — Pressed: every scent is built from a cultural moment you already know by heart." "02 — Numbered: each bottle is numbered and dated, a limited run with no repeats." "03 — Collected: when a pressing sells out, it's archived for good — wear it or shelf it." Hairline rules above and below.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-step-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-three-step-container-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-three-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-three-step-divider-top-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-three-step-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-three-step-column-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-three-step-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.number_letter_spacing }}px;
    margin: 0 0 {{ block.settings.number_spacing }}px;
    color: {{ block.settings.number_color }};
  }

  .ai-three-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-three-step-divider-bottom-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin-top: {{ block.settings.content_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-three-step-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_row_gap }}px;
    }

    .ai-three-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-three-step-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.9 }}px;
    }

    .ai-three-step-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-three-step-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-step-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-three-step-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-three-step-divider-top-{{ ai_gen_id }}"></div>

    <div class="ai-three-step-grid-{{ ai_gen_id }}">
      <div class="ai-three-step-column-{{ ai_gen_id }}">
        {% if block.settings.step_1_number != blank %}
          <div class="ai-three-step-number-{{ ai_gen_id }}">{{ block.settings.step_1_number }}</div>
        {% endif %}
        {% if block.settings.step_1_description != blank %}
          <p class="ai-three-step-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</p>
        {% endif %}
      </div>

      <div class="ai-three-step-column-{{ ai_gen_id }}">
        {% if block.settings.step_2_number != blank %}
          <div class="ai-three-step-number-{{ ai_gen_id }}">{{ block.settings.step_2_number }}</div>
        {% endif %}
        {% if block.settings.step_2_description != blank %}
          <p class="ai-three-step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</p>
        {% endif %}
      </div>

      <div class="ai-three-step-column-{{ ai_gen_id }}">
        {% if block.settings.step_3_number != blank %}
          <div class="ai-three-step-number-{{ ai_gen_id }}">{{ block.settings.step_3_number }}</div>
        {% endif %}
        {% if block.settings.step_3_description != blank %}
          <p class="ai-three-step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-three-step-divider-bottom-{{ ai_gen_id }}"></div>
  </div>
</div>

