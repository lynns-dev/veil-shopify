{% doc %}
  @prompt
    Create a "comparison" section. Background #F4F2EC with a 1px solid top and bottom
    border in rgba(22,20,15,0.16). Padding 100px 0, max width 1200px, centered header.
    
    Header: a small label (Hanken Grotesk 10px uppercase letter-spacing 0.34em color
    #8B8678) reading "The honest math"; below it a heading in Fraunces weight 300,
    clamp(30px,3.6vw,46px), color #16140F, reading "Same scent. Less the markup." with
    "Less the markup." in Fraunces italic.
    
    Below the header, a two-column box (margin-top 46px) with a 1px solid outer border
    rgba(22,20,15,0.16) and a 1px divider between the two cells:
    
    LEFT cell (padding 46px 44px): a tag (Hanken Grotesk 10px uppercase letter-spacing
    0.24em color #8B8678) "Luxury perfume"; a big figure in Fraunces weight 300, 46px,
    color #16140F, "$150–300"; then a bullet list with no markers (Hanken Grotesk 14px
    color #8B8678), each item with a 1px top border rgba(22,20,15,0.16) and 8px vertical
    padding (first item no top border): "One bottle", "Scents you and the whole room",
    "Fades by afternoon", "Sits on top of the skin".
    
    RIGHT cell (same padding): background #16140F, text #FCFBF7. Tag color
    rgba(252,251,247,0.6) reading "One jar of VEIL"; big figure "$45" in #FCFBF7; list
    items color rgba(252,251,247,0.78) with top borders rgba(252,251,247,0.22):
    "The wear of a full bottle", "Intimate, close-to-skin", "Pressed in — holds all
    day", "Melts in, soft-focus finish".
    
    On 760px and below, stack to one column; the divider becomes a top border on the
    second cell. Make the tags, figures, and list items editable. Keep hex values exact.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    background-color: #F4F2EC;
    border-top: 1px solid rgba(22, 20, 15, 0.16);
    border-bottom: 1px solid rgba(22, 20, 15, 0.16);
    padding: 100px 0;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-comparison-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-comparison-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 46px;
  }

  .ai-comparison-label-{{ ai_gen_id }} {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    color: #8B8678;
    margin-bottom: 12px;
  }

  .ai-comparison-heading-{{ ai_gen_id }} {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(30px, 3.6vw, 46px);
    color: #16140F;
    margin: 0;
    line-height: 1.2;
  }

  .ai-comparison-heading-{{ ai_gen_id }} em {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 300;
  }

  .ai-comparison-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid rgba(22, 20, 15, 0.16);
  }

  .ai-comparison-cell-{{ ai_gen_id }} {
    padding: 46px 44px;
  }

  .ai-comparison-cell-{{ ai_gen_id }}:first-child {
    border-right: 1px solid rgba(22, 20, 15, 0.16);
  }

  .ai-comparison-cell-{{ ai_gen_id }}--dark {
    background-color: #16140F;
    color: #FCFBF7;
  }

  .ai-comparison-tag-{{ ai_gen_id }} {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: #8B8678;
    margin-bottom: 16px;
    display: block;
  }

  .ai-comparison-cell-{{ ai_gen_id }}--dark .ai-comparison-tag-{{ ai_gen_id }} {
    color: rgba(252, 251, 247, 0.6);
  }

  .ai-comparison-price-{{ ai_gen_id }} {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: 46px;
    color: #16140F;
    margin-bottom: 24px;
    display: block;
  }

  .ai-comparison-cell-{{ ai_gen_id }}--dark .ai-comparison-price-{{ ai_gen_id }} {
    color: #FCFBF7;
  }

  .ai-comparison-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-comparison-list-item-{{ ai_gen_id }} {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14px;
    color: #8B8678;
    padding: 8px 0;
    border-top: 1px solid rgba(22, 20, 15, 0.16);
  }

  .ai-comparison-list-item-{{ ai_gen_id }}:first-child {
    border-top: none;
  }

  .ai-comparison-cell-{{ ai_gen_id }}--dark .ai-comparison-list-item-{{ ai_gen_id }} {
    color: rgba(252, 251, 247, 0.78);
    border-top-color: rgba(252, 251, 247, 0.22);
  }

  @media screen and (max-width: 760px) {
    .ai-comparison-{{ ai_gen_id }} {
      padding: 60px 0;
    }

    .ai-comparison-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-comparison-cell-{{ ai_gen_id }}:first-child {
      border-right: none;
      border-bottom: 1px solid rgba(22, 20, 15, 0.16);
    }

    .ai-comparison-cell-{{ ai_gen_id }}--dark {
      border-top: 1px solid rgba(252, 251, 247, 0.22);
    }

    .ai-comparison-cell-{{ ai_gen_id }} {
      padding: 32px 24px;
    }

    .ai-comparison-header-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }
  }
{% endstyle %}

<div class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-container-{{ ai_gen_id }}">
    <div class="ai-comparison-header-{{ ai_gen_id }}">
      <div class="ai-comparison-label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
      <h2 class="ai-comparison-heading-{{ ai_gen_id }}">
        {{ block.settings.heading_part_1 }} <em>{{ block.settings.heading_part_2 }}</em>
      </h2>
    </div>

    <div class="ai-comparison-grid-{{ ai_gen_id }}">
      <div class="ai-comparison-cell-{{ ai_gen_id }}">
        <span class="ai-comparison-tag-{{ ai_gen_id }}">{{ block.settings.left_tag }}</span>
        <span class="ai-comparison-price-{{ ai_gen_id }}">{{ block.settings.left_price }}</span>
        <ul class="ai-comparison-list-{{ ai_gen_id }}">
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.left_item_1 }}</li>
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.left_item_2 }}</li>
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.left_item_3 }}</li>
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.left_item_4 }}</li>
        </ul>
      </div>

      <div class="ai-comparison-cell-{{ ai_gen_id }} ai-comparison-cell-{{ ai_gen_id }}--dark">
        <span class="ai-comparison-tag-{{ ai_gen_id }}">{{ block.settings.right_tag }}</span>
        <span class="ai-comparison-price-{{ ai_gen_id }}">{{ block.settings.right_price }}</span>
        <ul class="ai-comparison-list-{{ ai_gen_id }}">
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.right_item_1 }}</li>
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.right_item_2 }}</li>
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.right_item_3 }}</li>
          <li class="ai-comparison-list-item-{{ ai_gen_id }}">{{ block.settings.right_item_4 }}</li>
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The honest math"
    },
    {
      "type": "text",
      "id": "heading_part_1",
      "label": "Heading part 1",
      "default": "Same scent."
    },
    {
      "type": "text",
      "id": "heading_part_2",
      "label": "Heading part 2 (italic)",
      "default": "Less the markup."
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "left_tag",
      "label": "Tag",
      "default": "Luxury perfume"
    },
    {
      "type": "text",
      "id": "left_price",
      "label": "Price",
      "default": "$150–300"
    },
    {
      "type": "text",
      "id": "left_item_1",
      "label": "Item 1",
      "default": "One bottle"
    },
    {
      "type": "text",
      "id": "left_item_2",
      "label": "Item 2",
      "default": "Scents you and the whole room"
    },
    {
      "type": "text",
      "id": "left_item_3",
      "label": "Item 3",
      "default": "Fades by afternoon"
    },
    {
      "type": "text",
      "id": "left_item_4",
      "label": "Item 4",
      "default": "Sits on top of the skin"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "right_tag",
      "label": "Tag",
      "default": "One jar of VEIL"
    },
    {
      "type": "text",
      "id": "right_price",
      "label": "Price",
      "default": "$45"
    },
    {
      "type": "text",
      "id": "right_item_1",
      "label": "Item 1",
      "default": "The wear of a full bottle"
    },
    {
      "type": "text",
      "id": "right_item_2",
      "label": "Item 2",
      "default": "Intimate, close-to-skin"
    },
    {
      "type": "text",
      "id": "right_item_3",
      "label": "Item 3",
      "default": "Pressed in — holds all day"
    },
    {
      "type": "text",
      "id": "right_item_4",
      "label": "Item 4",
      "default": "Melts in, soft-focus finish"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Comparison"
    }
  ]
}
{% endschema %}
