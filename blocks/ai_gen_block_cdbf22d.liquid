{% doc %}
  @prompt
    Add a three-column section titled "The composition" (small uppercase eyebrow). Each column has a small uppercase label with a thin top rule and a short sentence-case description: Top — "Vanilla milk, a dusting of sugar. Soft and warm on contact." Heart — "Marshmallow, tonka bean. Plush, sweet, a little addictive." Base — "White musk, skin. The clean, close finish that lingers like it's yours." No filled cards, just clean columns.
    
    , dynamic source option only for details of each column
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-composition-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    display: block;
  }

  .ai-composition-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-composition-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: {{ block.settings.eyebrow_margin }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-composition-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-composition-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-composition-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
    color: {{ block.settings.label_color }};
    padding-top: {{ block.settings.rule_spacing }}px;
    border-top: {{ block.settings.rule_width }}px solid {{ block.settings.rule_color }};
    margin-bottom: {{ block.settings.label_margin }}px;
  }

  .ai-composition-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    color: {{ block.settings.description_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-composition-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-composition-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-composition-container-{{ ai_gen_id }}">
    {% if block.settings.eyebrow != blank %}
      <div class="ai-composition-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow }}
      </div>
    {% endif %}

    <div class="ai-composition-columns-{{ ai_gen_id }}">
      <div class="ai-composition-column-{{ ai_gen_id }}">
        {% if block.settings.column_1_label != blank %}
          <div class="ai-composition-label-{{ ai_gen_id }}">
            {{ block.settings.column_1_label }}
          </div>
        {% endif %}
        {% if block.settings.column_1_description != blank %}
          <div class="ai-composition-description-{{ ai_gen_id }}">
            {{ block.settings.column_1_description }}
          </div>
        {% endif %}
      </div>

      <div class="ai-composition-column-{{ ai_gen_id }}">
        {% if block.settings.column_2_label != blank %}
          <div class="ai-composition-label-{{ ai_gen_id }}">
            {{ block.settings.column_2_label }}
          </div>
        {% endif %}
        {% if block.settings.column_2_description != blank %}
          <div class="ai-composition-description-{{ ai_gen_id }}">
            {{ block.settings.column_2_description }}
          </div>
        {% endif %}
      </div>

      <div class="ai-composition-column-{{ ai_gen_id }}">
        {% if block.settings.column_3_label != blank %}
          <div class="ai-composition-label-{{ ai_gen_id }}">
            {{ block.settings.column_3_label }}
          </div>
        {% endif %}
        {% if block.settings.column_3_description != blank %}
          <div class="ai-composition-description-{{ ai_gen_id }}">
            {{ block.settings.column_3_description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

