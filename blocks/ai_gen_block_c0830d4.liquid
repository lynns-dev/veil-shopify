{% doc %}
  @prompt
    Add a review section with a summary line ("★ 4.9 · 214 collector reviews," stars in pink) and three review columns: each with five pink stars, a short sentence-case quote, and a name in tiny uppercase. Quotes: "Smells like skin but better — I get asked what it is every single time." / "Soft, warm, a little addictive. Already nervous about it being archived." / "Bought it for the name, kept it for the actual scent. Obsessed." Connect this to my reviews app if I have one.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-summary-{{ ai_gen_id }} {
    text-align: {{ block.settings.summary_alignment }};
    margin-bottom: {{ block.settings.summary_spacing }}px;
  }

  .ai-reviews-summary-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.summary_font_size }}px;
    color: {{ block.settings.text_color }};
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ai-reviews-summary-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.summary_font_size }}px;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
    margin-bottom: {{ block.settings.stars_spacing }}px;
  }

  .ai-review-quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_font_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin-bottom: {{ block.settings.quote_spacing }}px;
  }

  .ai-review-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: {{ block.settings.author_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-reviews-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<product-reviews-{{ ai_gen_id }} class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_summary %}
    <div class="ai-reviews-summary-{{ ai_gen_id }}">
      <div class="ai-reviews-summary-text-{{ ai_gen_id }}">
        <span class="ai-reviews-summary-stars-{{ ai_gen_id }}">★</span>
        <span>{{ block.settings.summary_rating }} · {{ block.settings.summary_count }} {{ block.settings.summary_label }}</span>
      </div>
    </div>
  {% endif %}

  <div class="ai-reviews-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign review_enabled_key = 'review_' | append: i | append: '_enabled'
        assign review_quote_key = 'review_' | append: i | append: '_quote'
        assign review_author_key = 'review_' | append: i | append: '_author'

        assign review_enabled = block.settings[review_enabled_key]
        assign review_quote = block.settings[review_quote_key]
        assign review_author = block.settings[review_author_key]
      %}

      {% if review_enabled %}
        <div class="ai-review-card-{{ ai_gen_id }}">
          <div class="ai-review-stars-{{ ai_gen_id }}">★★★★★</div>
          {% if review_quote != blank %}
            <div class="ai-review-quote-{{ ai_gen_id }}">{{ review_quote }}</div>
          {% endif %}
          {% if review_author != blank %}
            <div class="ai-review-author-{{ ai_gen_id }}">{{ review_author }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</product-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.checkReviewsApp();
      }

      checkReviewsApp() {
        const reviewsAppSelectors = [
          '[data-reviews]',
          '.spr-container',
          '.yotpo',
          '.stamped-container',
          '.loox-reviews',
          '.judge-me-reviews',
          '.okendo-reviews'
        ];

        const hasReviewsApp = reviewsAppSelectors.some(selector => 
          document.querySelector(selector)
        );

        if (hasReviewsApp) {
          console.log('Reviews app detected. Consider integrating with your reviews platform.');
        }
      }
    }

    customElements.define('product-reviews-{{ ai_gen_id }}', ProductReviews{{ ai_gen_id }});
  })();
</script>

