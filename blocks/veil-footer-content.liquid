{% doc %}
  Minimal footer content matching the veil-ecommerce reference design:
  wordmark + nav links, a policy-links row, and a small disclaimer line.
  Replaces the theme's default multi-column menu footer.
{% enddoc %}

<div class="veil-footer" {{ block.shopify_attributes }}>
  <span class="veil-footer__wordmark">{{ shop.name }}</span>

  <nav class="veil-footer__nav">
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <a href="{{ routes.root_url }}#notes">Scent</a>
    <a href="{{ routes.root_url }}#reviews">Reviews</a>
  </nav>

  {% if shop.policies.size > 0 %}
    <div class="veil-footer__policies">
      {% for policy in shop.policies %}
        {% if policy != blank %}
          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <small class="veil-footer__disclaimer">{{ block.settings.disclaimer }}</small>
</div>

{% stylesheet %}
  .veil-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    width: 100%;
  }

  .veil-footer__wordmark {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 22px;
  }

  .veil-footer__nav {
    display: flex;
    gap: 24px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .veil-footer__nav a,
  .veil-footer__policies a {
    color: inherit;
    text-decoration: none;
  }

  .veil-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    width: 100%;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    margin-top: 4px;
  }

  .veil-footer__disclaimer {
    width: 100%;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 11px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer content",
  "settings": [
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer line",
      "default": "Poudre de corps parfumée"
    }
  ],
  "presets": [
    {
      "name": "Footer content"
    }
  ]
}
{% endschema %}
