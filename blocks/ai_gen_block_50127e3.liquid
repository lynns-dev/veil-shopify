      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Now pressing — No. 004"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title override"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Font size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description text",
      "default": "A scent for the girl who orders a double and means it"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Font size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Notes"
    },
    {
      "type": "text",
      "id": "notes",
      "label": "Notes text",
      "default": "Espresso · black cherry · whipped vanilla · tonka"
    },
    {
      "type": "range",
      "id": "notes_size",
      "label": "Font size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "notes_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price override"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Font size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Scarcity note"
    },
    {
      "type": "text",
      "id": "scarcity_note",
      "label": "Scarcity text",
