{% doc %}
  @prompt
    Add a featured-product section, two columns. One side: a large square product photo on Bone. Other side: eyebrow "Now pressing — No. 004," title "ESPRESSO" in uppercase semibold, an italic line "A scent for the girl who orders a double and means it," a tiny uppercase notes line "Espresso · black cherry · whipped vanilla · tonka," the price "$32," a small scarcity note "Selling fast — limited run," and a solid Ink "Add to bag" button. Keep it calm and spaced out.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-product-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-featured-product-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 40px;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-featured-product-image-column-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background_color }};
    padding: 40px;
    border-radius: 8px;
  }

  .ai-featured-product-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1 / 1;
  }

  .ai-featured-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  .ai-featured-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-featured-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-featured-product-content-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }

  .ai-featured-product-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  .ai-featured-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
    line-height: 1.1;
  }

  .ai-featured-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-style: italic;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-featured-product-notes-{{ ai_gen_id }} {
    font-size: {{ block.settings.notes_size }}px;
    color: {{ block.settings.notes_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .ai-featured-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 500;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-featured-product-scarcity-{{ ai_gen_id }} {
    font-size: {{ block.settings.scarcity_size }}px;
    color: {{ block.settings.scarcity_color }};
    margin: 0;
  }

  .ai-featured-product-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    width: fit-content;
  }

  .ai-featured-product-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-featured-product-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 40px 20px;
    }

    .ai-featured-product-image-column-{{ ai_gen_id }} {
      padding: 30px;
    }

    .ai-featured-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<featured-product-{{ ai_gen_id }} class="ai-featured-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-product-container-{{ ai_gen_id }}">
    <div class="ai-featured-product-image-column-{{ ai_gen_id }}">
      <div class="ai-featured-product-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product and block.settings.product.featured_image %}
          <img
            src="{{ block.settings.product.featured_image | image_url: width: 1000 }}"
            alt="{{ block.settings.product.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product.featured_image.width }}"
            height="{{ block.settings.product.featured_image.height }}"
            class="ai-featured-product-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-featured-product-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-featured-product-content-column-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-featured-product-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.product %}
        <h2 class="ai-featured-product-title-{{ ai_gen_id }}">{{ block.settings.product.title }}</h2>
      {% elsif block.settings.title != blank %}
        <h2 class="ai-featured-product-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="ai-featured-product-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}

      {% if block.settings.notes != blank %}
        <p class="ai-featured-product-notes-{{ ai_gen_id }}">{{ block.settings.notes }}</p>
      {% endif %}

      {% if block.settings.product %}
        <p class="ai-featured-product-price-{{ ai_gen_id }}">{{ block.settings.product.price | money }}</p>
      {% elsif block.settings.price != blank %}
        <p class="ai-featured-product-price-{{ ai_gen_id }}">{{ block.settings.price }}</p>
      {% endif %}

      {% if block.settings.scarcity_note != blank %}
        <p class="ai-featured-product-scarcity-{{ ai_gen_id }}">{{ block.settings.scarcity_note }}</p>
      {% endif %}

      {% if block.settings.product %}
        <a
          href="{{ block.settings.product.url }}"
          class="ai-featured-product-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% elsif block.settings.button_link %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-featured-product-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% else %}
        <button class="ai-featured-product-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    </div>
  </div>
</featured-product-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
