{% doc %}
  Renders a discounted upsell add-on card in the cart drawer (e.g. "The Grand Puff at 10% off").
  Configured via the "Cart Drawer Upsell & Progress" theme settings — merchant picks the
  product and discount percentage, no code changes needed to swap it out.

  Note: the discounted price shown here is cosmetic. For checkout to actually charge the
  reduced price, create a matching Automatic Discount in Shopify Admin (Discounts → Create
  discount → Automatic discount) scoped to this same product.
{% enddoc %}

{% liquid
  assign upsell_product = settings.cart_upsell_product
%}

{% if upsell_product and cart.item_count > 0 %}
  {% liquid
    assign already_in_cart = false
    for item in cart.items
      if item.product_id == upsell_product.id
        assign already_in_cart = true
      endif
    endfor
  %}

  {% unless already_in_cart %}
    {% liquid
      assign upsell_variant = upsell_product.selected_or_first_available_variant
      assign discount_pct = settings.cart_upsell_discount_percentage
      assign remaining_pct = 100 | minus: discount_pct
      assign discounted_price = upsell_variant.price | times: remaining_pct | divided_by: 100
    %}

    <script
      src="{{ 'cart-upsell.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>

    <cart-upsell class="cart-upsell">
      <p class="cart-upsell__heading">{{ 'content.cart_upsell_heading' | t }}</p>
      <div class="cart-upsell__card">
        <a
          href="{{ upsell_product.url }}"
          class="cart-upsell__media"
        >
          {%- if upsell_product.featured_image -%}
            {{ upsell_product.featured_image | image_url: width: 176 | image_tag: loading: 'lazy', alt: upsell_product.title, widths: '88,176' }}
          {%- endif -%}
        </a>
        <div class="cart-upsell__info">
          <p class="cart-upsell__name">{{ upsell_product.title }}</p>
          <p class="cart-upsell__price">
            <s class="cart-upsell__price-original">{{ upsell_variant.price | money }}</s>
            <span class="cart-upsell__price-discounted">{{ discounted_price | money }}</span>
            <span class="cart-upsell__badge">{{ 'content.cart_upsell_discount_label' | t: percentage: discount_pct }}</span>
          </p>
        </div>
        <button
          type="button"
          class="button cart-upsell__add-button"
          data-cart-upsell-add
          data-variant-id="{{ upsell_variant.id }}"
        >
          {{ 'actions.add' | t }}
        </button>
      </div>
    </cart-upsell>
  {% endunless %}
{% endif %}

{% stylesheet %}
  .cart-upsell {
    display: block;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    padding: var(--padding-lg) var(--padding-md);
    margin-inline: var(--cart-drawer-padding-desktop, var(--padding-xl));
    margin-block-end: var(--margin-lg);
  }

  .cart-upsell__heading {
    font-size: var(--font-size--2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    margin-block-end: var(--margin-sm);
  }

  .cart-upsell__card {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
  }

  .cart-upsell__media {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: block;
    overflow: hidden;
  }

  .cart-upsell__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-upsell__info {
    flex: 1;
    min-width: 0;
  }

  .cart-upsell__name {
    font-size: var(--font-size--sm);
    margin: 0;
  }

  .cart-upsell__price {
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    margin-block-start: var(--margin-3xs);
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-upsell__price-original {
    text-decoration: line-through;
  }

  .cart-upsell__badge {
    text-transform: uppercase;
    font-size: var(--font-size--2xs);
  }

  .cart-upsell__add-button {
    flex-shrink: 0;
    font-size: var(--font-size--2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    padding: var(--padding-sm) var(--padding-md);
    height: auto;
  }

  .cart-upsell__add-button:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
{% endstylesheet %}
